---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
  class?: string;
  style?: string;
  widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
---

<WidgetLayout
  name="访客信息"
  showTitle={showTitle}
  id="visitor-info"
  class={className}
  style={style}
>
  <div class="visitor-info-content" data-state="loading">
    <div class="visitor-info-loading" aria-live="polite">
      <span class="visitor-info-spinner"></span>
      <span>正在获取访客信息…</span>
    </div>

    <div class="visitor-info-error hidden" aria-live="polite">
      <Icon name="material-symbols:cloud-off-outline" class="text-[1.15rem] shrink-0 text-(--primary)" />
      <span>访客信息暂时无法获取</span>
    </div>

    <div class="visitor-info-data hidden">
      <div class="visitor-info-grid">
        <div class="visitor-info-item visitor-info-item-wide">
          <div class="visitor-info-icon">
            <Icon name="material-symbols:public" />
          </div>
          <div class="visitor-info-copy">
            <span class="visitor-info-label">IP 地址</span>
            <strong class="visitor-info-value visitor-ip" title="">—</strong>
          </div>
        </div>

        <div class="visitor-info-item">
          <div class="visitor-info-icon">
            <Icon name="material-symbols:location-on-outline" />
          </div>
          <div class="visitor-info-copy">
            <span class="visitor-info-label">地理位置</span>
            <strong class="visitor-info-value visitor-location" title="">—</strong>
          </div>
        </div>

        <div class="visitor-info-item">
          <div class="visitor-info-icon">
            <Icon name="material-symbols:schedule" />
          </div>
          <div class="visitor-info-copy">
            <span class="visitor-info-label">时区</span>
            <strong class="visitor-info-value visitor-timezone" title="">—</strong>
          </div>
        </div>

        <div class="visitor-info-item">
          <div class="visitor-info-icon">
            <Icon name="material-symbols:devices" />
          </div>
          <div class="visitor-info-copy">
            <span class="visitor-info-label">设备 / 系统</span>
            <strong class="visitor-info-value visitor-device" title="">—</strong>
          </div>
        </div>

        <div class="visitor-info-item">
          <div class="visitor-info-icon">
            <Icon name="material-symbols:language" />
          </div>
          <div class="visitor-info-copy">
            <span class="visitor-info-label">浏览器</span>
            <strong class="visitor-info-value visitor-browser" title="">—</strong>
          </div>
        </div>

        <div class="visitor-info-item visitor-info-item-wide">
          <div class="visitor-info-icon">
            <Icon name="material-symbols:code" />
          </div>
          <div class="visitor-info-copy">
            <span class="visitor-info-label">User Agent</span>
            <strong class="visitor-info-value visitor-user-agent" title="">—</strong>
          </div>
        </div>

        <div class="visitor-info-item visitor-info-item-wide">
          <div class="visitor-info-icon">
            <Icon name="material-symbols:cell-tower" />
          </div>
          <div class="visitor-info-copy">
            <span class="visitor-info-label">网络</span>
            <strong class="visitor-info-value visitor-network" title="">—</strong>
          </div>
        </div>
      </div>

      <div class="visitor-info-note">
        <Icon name="material-symbols:info-outline" class="shrink-0" />
        <span>IP 地理位置为网络级估算，可能与实际位置存在偏差。</span>
      </div>
    </div>
  </div>
</WidgetLayout>

<style>
  .visitor-info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .visitor-info-item {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.625rem 0.5rem;
    border-radius: 0.625rem;
    background: rgb(128 128 128 / 0.07);
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .visitor-info-item:hover {
    background: rgb(128 128 128 / 0.12);
    transform: translateY(-1px);
  }

  .visitor-info-item-wide {
    grid-column: 1 / -1;
  }

  .visitor-info-icon {
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--primary);
    background: rgb(128 128 128 / 0.08);
    font-size: 1.05rem;
  }

  .visitor-info-icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .visitor-info-copy {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .visitor-info-label {
    font-size: 0.68rem;
    line-height: 1rem;
    color: rgb(115 115 115);
  }

  :global(.dark) .visitor-info-label {
    color: rgb(190 190 190);
  }

  .visitor-info-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.78rem;
    line-height: 1.1rem;
    font-weight: 700;
    color: rgb(38 38 38);
  }

  :global(.dark) .visitor-info-value {
    color: rgb(255 255 255);
  }

  .visitor-info-note {
    margin-top: 0.625rem;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.66rem;
    line-height: 1rem;
    color: rgb(115 115 115);
    background: rgb(128 128 128 / 0.045);
  }

  :global(.dark) .visitor-info-note {
    color: rgb(190 190 190);
  }

  .visitor-info-loading,
  .visitor-info-error {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 5rem;
    padding: 0.75rem;
    border-radius: 0.625rem;
    color: rgb(115 115 115);
    font-size: 0.78rem;
  }

  :global(.dark) .visitor-info-loading,
  :global(.dark) .visitor-info-error {
    color: rgb(190 190 190);
  }

  .visitor-info-spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid rgb(128 128 128 / 0.22);
    border-top-color: var(--primary);
    border-radius: 9999px;
    animation: visitor-info-spin 700ms linear infinite;
  }

  @keyframes visitor-info-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 480px) {
    .visitor-info-grid {
      grid-template-columns: 1fr;
    }

    .visitor-info-item-wide {
      grid-column: auto;
    }
  }
</style>

<script>
  type IpLocation = {
    ip?: string;
    city?: string;
    region?: string;
    country?: string;
    country_code?: string;
    timezone?: string;
    latitude?: string | number;
    longitude?: string | number;
    asn?: string | number;
    asn_organization?: string;
    isp?: string;
    organization?: string;
    colo?: string;
  };

  const setupVisitorInfo = (root: Element) => {
    const loading = root.querySelector(".visitor-info-loading");
    const error = root.querySelector(".visitor-info-error");
    const data = root.querySelector(".visitor-info-data");
    if (!loading || !error || !data) return;

    // User Agent / 设备 / 浏览器属于浏览器本地信息，不依赖第三方 API。
    // 先展示这部分，即使 IP 地理服务临时不可用，部件也不会整体失败。
    const localUa = navigator.userAgent || "—";

    const setText = (selector: string, value: string) => {
      const el = root.querySelector(selector) as HTMLElement | null;
      if (!el) return;
      el.textContent = value || "—";
      el.title = value || "—";
    };

    const detectBrowser = (ua: string) => {
      if (/Edg\//i.test(ua)) return "Microsoft Edge";
      if (/OPR\//i.test(ua) || /Opera/i.test(ua)) return "Opera";
      if (/Chrome\//i.test(ua) && !/Edg\//i.test(ua)) return "Google Chrome";
      if (/Firefox\//i.test(ua)) return "Mozilla Firefox";
      if (/Safari\//i.test(ua) && !/Chrome\//i.test(ua)) return "Safari";
      if (/SamsungBrowser\//i.test(ua)) return "Samsung Internet";
      return "其他浏览器";
    };

    const detectOs = (ua: string) => {
      if (/Windows NT/i.test(ua)) return "Windows";
      if (/Android/i.test(ua)) return "Android";
      if (/iPhone|iPad|iPod/i.test(ua)) return "iOS";
      if (/Mac OS X/i.test(ua)) return "macOS";
      if (/Linux/i.test(ua)) return "Linux";
      if (/CrOS/i.test(ua)) return "ChromeOS";
      return "其他系统";
    };

    const detectDevice = (ua: string) => {
      if (/iPad|Tablet/i.test(ua)) return "平板";
      if (/Mobile|iPhone|Android/i.test(ua)) return "手机";
      return "桌面";
    };

    const load = async () => {
      const ua = localUa;

      // 先立即展示无需 API 的访客环境信息。
      setText(".visitor-device", `${detectDevice(ua)} / ${detectOs(ua)}`);
      setText(".visitor-browser", detectBrowser(ua));
      setText(".visitor-user-agent", ua);

      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 6000);

      try {
        // 使用本站同源 Cloudflare Worker，直接读取 Cloudflare request.cf。
        // 不再依赖第三方浏览器 CORS/API，因此不会被 ipapi/ip.sb 的跨域策略或网络拦截影响。
        const response = await fetch("/api/visitor-info", {
          method: "GET",
          headers: { Accept: "application/json" },
          signal: controller.signal,
          credentials: "same-origin",
          cache: "no-store",
        });

        if (!response.ok) throw new Error("IP location request failed");

        const result = (await response.json()) as IpLocation;
        const locationParts = [result.country, result.region, result.city]
          .filter(Boolean)
          .join(" / ");

        const coordinates =
          Number.isFinite(result.latitude) && Number.isFinite(result.longitude)
            ? `${result.latitude}, ${result.longitude}`
            : "";

        const network = [
          result.asn ? `AS${result.asn}` : "",
          result.asn_organization,
          result.isp,
          result.organization,
          result.colo ? `Edge ${result.colo}` : "",
        ]
          .filter(Boolean)
          .join(" · ");

        setText(".visitor-ip", result.ip || "—");
        setText(".visitor-location", locationParts || "—");
        setText(".visitor-timezone", result.timezone || "—");
        setText(
          ".visitor-network",
          network || coordinates || result.asn_organization || "—",
        );

        if (coordinates) {
          const locationEl = root.querySelector(
            ".visitor-location",
          ) as HTMLElement | null;
          if (locationEl) {
            locationEl.title = locationParts
              ? `${locationParts} · ${coordinates}`
              : coordinates;
          }
        }

        loading.classList.add("hidden");
        data.classList.remove("hidden");
        root.querySelector(".visitor-info-content")?.setAttribute("data-state", "ready");
      } catch {
        // Worker/API 异常时仍保留本地浏览器信息。
        setText(".visitor-ip", "暂不可用");
        setText(".visitor-location", "暂不可用");
        setText(".visitor-timezone", "暂不可用");
        setText(".visitor-network", "暂不可用");
        loading.classList.add("hidden");
        data.classList.remove("hidden");
        error.classList.add("hidden");
        root.querySelector(".visitor-info-content")?.setAttribute("data-state", "partial");
      } finally {
        window.clearTimeout(timer);
      }
    };

    load();
  };

  document.querySelectorAll("widget-layout[data-id='visitor-info']").forEach(setupVisitorInfo);
</script>
